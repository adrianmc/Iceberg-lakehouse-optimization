# Configuración para scripts/maintenance_impala.sh
#
# Copiar a config.env y completar. NO versionar config.env — está en .gitignore.
#   cp scripts/config.env.example scripts/config.env
#   chmod 600 scripts/config.env

# ── Conexión ───────────────────────────────────────────────────────────────────────────
# Obtener desde: CDW → Virtual Warehouse → menú de opciones → Copy Impala shell command
# El comando copiado tiene la forma:
#   impala-shell --protocol='hs2-http' --ssl -i "<host>:443"
IMPALA_HOST="coordinator-vw-impala.dw-xxxxxx.xxxxxx.cloudera.site"
IMPALA_PORT="443"

# Usuario de workload de CDP
IMPALA_USER="svc_mantenimiento_iceberg"

# ── Contraseña ─────────────────────────────────────────────────────────────────────────
# NUNCA poner la contraseña en texto plano aquí.
# IMPALA_PASSWORD_CMD debe ser un comando que la imprima por stdout.
#
# Opción A — gestor de secretos (recomendado en producción)
#   IMPALA_PASSWORD_CMD="aws secretsmanager get-secret-value --secret-id iceberg/impala --query SecretString --output text"
#   IMPALA_PASSWORD_CMD="vault kv get -field=password secret/cdp/impala"
#
# Opción B — archivo local con permisos restrictivos (chmod 600)
#   IMPALA_PASSWORD_CMD="cat /etc/cdp/.impala_pw"
#
# Si se deja vacío, impala-shell solicitará la contraseña de forma interactiva
# (válido para ejecución manual, no para cron).
IMPALA_PASSWORD_CMD=""

# ── Alcance del mantenimiento ──────────────────────────────────────────────────────────
TABLAS="telco_core.cdr_voz,telco_core.cdr_datos,telco_core.eventos_red_kpi"

# ── Parámetros ─────────────────────────────────────────────────────────────────────────
# Umbral de compactación. Con umbral se seleccionan solo archivos pequeños y delete files,
# lo que ahorra cómputo de forma significativa en el mantenimiento recurrente.
UMBRAL_MB="256"

# Días de retención de snapshots (ventana de time travel)
RETENCION_DIAS="7"

# Columnas para COMPUTE STATS. Incluir solo las que participan en filtros, joins y GROUP BY.
# Dejar vacío para omitir el paso.
COLUMNAS_STATS="fecha_evento, msisdn_origen, id_celda_origen, tipo_llamada, id_plan"

# Directorio de logs
LOG_DIR="./logs"

# ── Variables del camino CDE / Spark ───────────────────────────────────────────────────
# Este archivo también alimenta las variables de entorno del job cde/maintenance_job.py.
# Mantener ambos caminos con la MISMA configuración evita que diverjan.
# Ver docs/07-paridad-caminos.md

# Snapshots mínimos a conservar (parámetro retain_last de expire_snapshots).
# NUNCA 0: dejaría la tabla sin snapshot activo.
# En el camino por Impala esto se controla con history.expire.min-snapshots-to-keep
# a nivel de tabla, no por parámetro del comando.
RETAIN_LAST="2"

# Catálogo Iceberg en Spark. Con HiveCatalog (default en CDE) es spark_catalog.
SPARK_CATALOG="spark_catalog"

# Filtro opcional para rewrite_data_files — solo camino Spark.
# Impala NO soporta filtro de partición en OPTIMIZE TABLE.
# ADVERTENCIA: hay reportes de fallo cuando el filtro involucra partition transforms
# como days() o months(). Validar antes de usar en producción.
WHERE_FILTER=""
